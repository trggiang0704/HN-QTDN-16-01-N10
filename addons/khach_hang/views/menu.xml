<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_open_crm_dashboard" model="ir.actions.server">
            <field name="name">Tổng quan</field>
            <field name="model_id" ref="model_khach_hang_dashboard"/>
            <field name="state">code</field>
            <field name="code">
                action = model.action_get_dashboard()
            </field>
        </record>

        <menuitem id="menu_kh_root_final" name="Quản lý Khách hàng" sequence="20"/>

        <menuitem id="menu_kh_dashboard" name="Tổng quan" 
                  parent="menu_kh_root_final" 
                  action="action_open_crm_dashboard" 
                  sequence="5"/>

        <menuitem id="menu_kh_main_final" name="Khách hàng" parent="menu_kh_root_final" sequence="10"/>
        
        <menuitem id="menu_kh_list_final" name="Danh sách khách hàng" 
                  parent="menu_kh_main_final" 
                  action="action_khach_hang_chinh_thuc" 
                  sequence="10"/>
        
        <menuitem id="menu_kh_tn_list_final" name="Khách hàng tiềm năng (Lead)" 
                  parent="menu_kh_main_final" 
                  action="action_khach_hang_tiem_nang" 
                  sequence="20"/>

        <menuitem id="menu_giao_dich_root" name="Giao dịch" parent="menu_kh_root_final" sequence="20"/>
        
        <menuitem id="menu_hop_dong_list" name="Hợp đồng" 
                  parent="menu_giao_dich_root" 
                  action="action_hop_dong" 
                  sequence="10"/>
                    
        <menuitem id="menu_ho_tro_list" name="Hỗ trợ khách hàng" 
                  parent="menu_giao_dich_root" 
                  action="action_ho_tro_khach_hang" 
                  sequence="20"/>
        
        <menuitem id="menu_bao_gia_list" name="Báo giá" 
                  parent="menu_giao_dich_root" 
                  action="action_bao_gia" 
                  sequence="5"/>

        <!-- Cấu hình AI & Telegram -->
        <menuitem id="menu_kh_config_root" name="Cấu hình" parent="menu_kh_root_final" sequence="99"/>

        <menuitem id="menu_api_config" name="⚙️ Cấu hình AI &amp; Telegram" 
                  parent="menu_kh_config_root"
                  action="action_api_config_wizard"
                  sequence="10"/>

        <menuitem id="menu_ai_chatbot" name="🤖 AI Trợ lý Chatbot"
                  parent="menu_kh_config_root"
                  action="action_ai_chatbot_general"
                  sequence="5"/>
    </data>
</odoo>
