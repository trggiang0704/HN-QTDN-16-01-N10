<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bao_gia_tree" model="ir.ui.view">
            <field name="name">bao_gia.tree</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <tree string="Danh sách Báo giá" decoration-info="trang_thai == 'du_thao'" decoration-success="trang_thai == 'chap_nhan'" decoration-danger="trang_thai == 'tu_choi'">
                    <field name="so_bao_gia"/>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="ngay_lap"/>
                    <field name="tong_tien" sum="Tổng giá trị báo giá" widget="monetary"/>
                    <field name="trang_thai" widget="badge" 
                           decoration-info="trang_thai == 'da_gui'" 
                           decoration-success="trang_thai == 'chap_nhan'" 
                           decoration-danger="trang_thai == 'tu_choi'"/>
                </tree>
            </field>
        </record>

        <record id="view_bao_gia_form" model="ir.ui.view">
            <field name="name">bao_gia.form</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_gui_mail_bao_gia" 
                                string="Gửi khách hàng" 
                                type="object" 
                                class="oe_highlight" 
                                attrs="{'invisible': [('trang_thai', '!=', 'du_thao')]}"/>
                        
                        <field name="trang_thai" widget="statusbar" clickable="1" statusbar_visible="du_thao,da_gui,chap_nhan"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="so_bao_gia"/></h1>
                        </div>
                        <group>
                            <group string="Thông tin chung">
                                <field name="khach_hang_id" options="{'no_create': True}"/>
                                <field name="nhan_vien_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Thời gian &amp; Hiệu lực">
                                <field name="ngay_lap"/>
                                <field name="ngay_het_han"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Chi tiết hàng hóa" name="order_lines">
                                <field name="chi_tiet_ids" mode="tree">
                                    <tree editable="bottom" string="Thêm hàng hóa">
                                        <field name="san_pham_mau"/>
                                        <field name="ten_hien_thi"/>
                                        <field name="so_luong"/>
                                        <field name="don_gia" widget="monetary"/>
                                        <field name="giam_gia" string="Giảm giá (%)"/>
                                        <field name="thanh_tien" widget="monetary" force_save="1"/>
                                    </tree>
                                </field>

                                <group class="oe_subtotal_footer oe_right" colspan="2" name="bao_gia_total">
                                    <field name="tien_hang_chua_thue" string="Tiền hàng (sau giảm)" widget="monetary"/>
                                    
                                    <field name="tong_giam_gia_percent" string="Giảm giá (%)" style="color: #e74c3c; font-weight: bold;"/>
                                    
                                    <field name="thue_vat_phan_tram" widget="selection" class="oe_inline"/>
                                    <field name="thue_vat_thanh_tien" widget="monetary"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="tong_tien"/>
                                    </div>
                                    <field name="tong_tien" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                                <div class="oe_clear"/>
                            </page>

                            <page string="Điều khoản &amp; Ghi chú">
                                <field name="ghi_chu" placeholder="Nhập các điều khoản ưu đãi, ghi chú thanh toán..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Kanban View of Quotations -->
        <record id="view_bao_gia_kanban" model="ir.ui.view">
            <field name="name">bao_gia.kanban</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trang_thai" class="o_kanban_small_column" create="true">
                    <field name="id"/>
                    <field name="so_bao_gia"/>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="ngay_lap"/>
                    <field name="tong_tien"/>
                    <field name="trang_thai"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click" style="border-radius: 8px; border-top: 4px solid #f1c40f; box-shadow: 0 4px 6px rgba(0,0,0,0.02); padding: 15px; margin-bottom: 15px; background: white; min-width: 250px;">
                                <div class="oe_kanban_details">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                        <span class="badge badge-pill" style="background-color: #fef9e7; color: #d4ac0d; font-size: 10px; padding: 3px 8px; font-weight: bold; text-transform: uppercase;">BÁO GIÁ</span>
                                    </div>

                                    <strong class="o_kanban_record_title" style="font-size: 15px; color: #2d3748; display: block; margin-bottom: 8px; line-height: 1.3;">
                                        <field name="so_bao_gia"/>
                                    </strong>
                                    
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 4px;">
                                        <i class="fa fa-user" style="color: #3498db; margin-right: 5px;"></i> Khách hàng: <field name="khach_hang_id"/>
                                    </div>
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 4px;">
                                        <i class="fa fa-usd" style="color: #e67e22; margin-right: 5px;"></i> Tổng tiền: <field name="tong_tien"/>
                                    </div>
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 10px;">
                                        <i class="fa fa-user-circle" style="color: #9b59b6; margin-right: 5px;"></i> Phụ trách: <field name="nhan_vien_id"/>
                                    </div>

                                    <!-- Bottom Row Action -->
                                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf2f7; padding-top: 10px;">
                                        <span class="badge badge-pill" style="font-size: 10px; padding: 3px 8px; font-weight: bold; background-color: #f4f6f7; color: #7f8c8d;">
                                            <field name="trang_thai"/>
                                        </span>
                                        <a type="open" class="btn btn-sm btn-outline-primary" role="button" style="border-radius: 4px; padding: 2px 10px; font-size: 10px; color: #d4ac0d; border-color: #d4ac0d; cursor: pointer;">Chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_bao_gia" model="ir.actions.act_window">
            <field name="name">Báo giá</field>
            <field name="res_model">bao_gia</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Chưa có báo giá nào được tạo. Bấm "Tạo mới" để bắt đầu.
                </p>
            </field>
        </record>
    </data>
</odoo>
