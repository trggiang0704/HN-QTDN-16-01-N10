<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hop_dong_tree" model="ir.ui.view">
            <field name="name">hop_dong.tree</field>
            <field name="model">hop_dong</field>
            <field name="arch" type="xml">
                <tree string="Danh sách Hợp đồng" 
                      decoration-info="trang_thai == 'moi'" 
                      decoration-success="thanh_toan == 'da_thanh_toan'"
                      decoration-danger="thanh_toan == 'chua_thanh_toan'">
                    
                    <field name="display_info_contract" string="Hợp đồng"/>
                    <field name="display_customer_info" string="Bên A (Khách hàng)"/>
                    <field name="display_staff_info" string="Bên B (Đại diện)"/>
                    <field name="ngay_bat_dau" string="Ngày ký"/>
                    <field name="gia_tri_hop_dong" sum="Tổng doanh thu" widget="monetary"/>
                    
                    <field name="thanh_toan" widget="badge" 
                           decoration-success="thanh_toan == 'da_thanh_toan'" 
                           decoration-warning="thanh_toan == 'thanh_toan_mot_phan'" 
                           decoration-danger="thanh_toan == 'chua_thanh_toan'"/>

                    <field name="trang_thai" widget="badge" 
                           decoration-info="trang_thai == 'dang_thuc_hien'" 
                           decoration-success="trang_thai == 'hoan_thanh'"/>
                </tree>
            </field>
        </record>

        <record id="view_hop_dong_form" model="ir.ui.view">
            <field name="name">hop_dong.form</field>
            <field name="model">hop_dong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_send_contract_email" 
                                string="Gửi Email Hợp đồng" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-envelope"
                                attrs="{'invisible': [('so_hop_dong', '=', 'Mới')]}"/>

                        <!-- MỨC 3: AI - Phân tích Hợp đồng bằng Gemini Vision -->
                        <button name="action_ai_extract_contract"
                                string="🤖 AI Phân tích HĐ"
                                type="object"
                                class="btn-warning"
                                icon="fa-magic"
                                attrs="{'invisible': [('file_hop_dong', '=', False)]}"
                                confirm="AI sẽ đọc file hợp đồng và tự động điền thông tin vào bản ghi. Tiếp tục?"/>

                        <!-- MỨC 3: AI Chatbot -->
                        <button name="action_open_ai_chatbot"
                                string="💬 Hỏi AI"
                                type="object"
                                class="btn-info"
                                attrs="{'invisible': [('so_hop_dong', '=', 'Mới')]}"/>

                        <!-- MỨC 3: External API - Gửi thông báo Telegram -->
                        <button name="action_send_telegram_notification"
                                string="📱 Gửi Telegram"
                                type="object"
                                class="btn-secondary"
                                icon="fa-paper-plane"
                                attrs="{'invisible': [('so_hop_dong', '=', 'Mới')]}"/>

                        <field name="trang_thai" widget="statusbar" clickable="1"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="so_hop_dong" string="SỐ HỢP ĐỒNG"/>
                            <h1><field name="so_hop_dong"/></h1>
                            <label for="ten" string="TIÊU ĐỀ HỢP ĐỒNG"/>
                            <h2><field name="ten" placeholder="Ví dụ: Hợp đồng cung cấp dịch vụ phần mềm..."/></h2>
                        </div>
                        <group>
                            <group string="Thông tin đối tác &amp; Tài chính">
                                <field name="khach_hang_id" options="{'no_create': True, 'no_open': False}"/>
                                <field name="nhan_vien_id" options="{'no_create': True}"/>
                                <field name="gia_tri_hop_dong"/>
                                <field name="thanh_toan" widget="radio" options="{'horizontal': True}"/>
                            </group>
                            <group string="Thời hạn &amp; Hồ sơ">
                                <field name="ngay_bat_dau"/>
                                <field name="ngay_ket_thuc"/>
                                <field name="file_hop_dong" filename="file_name" widget="binary"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Ghi chú điều khoản">
                                <field name="ghi_chu" placeholder="Nhập các điều khoản đặc biệt, cam kết bảo mật..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Kanban View of Contracts -->
        <record id="view_hop_dong_kanban" model="ir.ui.view">
            <field name="name">hop_dong.kanban</field>
            <field name="model">hop_dong</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trang_thai" class="o_kanban_small_column" create="true">
                    <field name="id"/>
                    <field name="so_hop_dong"/>
                    <field name="ten"/>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="gia_tri_hop_dong"/>
                    <field name="thanh_toan"/>
                    <field name="trang_thai"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click" style="border-radius: 8px; border-top: 4px solid #2ecc71; box-shadow: 0 4px 6px rgba(0,0,0,0.02); padding: 15px; margin-bottom: 15px; background: white; min-width: 250px;">
                                <div class="oe_kanban_details">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                        <span class="badge badge-pill" style="background-color: #e8f8f5; color: #117a65; font-size: 10px; padding: 3px 8px; font-weight: bold; text-transform: uppercase;">HỢP ĐỒNG</span>
                                    </div>

                                    <strong class="o_kanban_record_title" style="font-size: 14px; color: #2d3748; display: block; margin-bottom: 8px; line-height: 1.3;">
                                        <field name="ten"/>
                                    </strong>
                                    
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 4px;">
                                        <i class="fa fa-tag" style="color: #9b59b6; margin-right: 5px;"></i> Số HĐ: <field name="so_hop_dong"/>
                                    </div>
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 4px;">
                                        <i class="fa fa-user" style="color: #3498db; margin-right: 5px;"></i> Khách hàng: <field name="khach_hang_id"/>
                                    </div>
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 4px;">
                                        <i class="fa fa-money" style="color: #2ecc71; margin-right: 5px;"></i> Giá trị: <field name="gia_tri_hop_dong"/>
                                    </div>
                                    <div style="font-size: 11px; color: #718096; margin-bottom: 10px;">
                                        <i class="fa fa-credit-card" style="color: #e67e22; margin-right: 5px;"></i> Thanh toán: <field name="thanh_toan"/>
                                    </div>

                                    <!-- Bottom Row Action -->
                                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf2f7; padding-top: 10px;">
                                        <span class="badge badge-pill" style="font-size: 10px; padding: 3px 8px; font-weight: bold; background-color: #f4f6f7; color: #7f8c8d;">
                                            <field name="trang_thai"/>
                                        </span>
                                        <a type="open" class="btn btn-sm btn-outline-primary" role="button" style="border-radius: 4px; padding: 2px 10px; font-size: 10px; color: #2ecc71; border-color: #2ecc71; cursor: pointer;">Chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_hop_dong" model="ir.actions.act_window">
            <field name="name">Hợp đồng khách hàng</field>
            <field name="res_model">hop_dong</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Chưa có hợp đồng nào. Hãy tạo mới hoặc tải file PDF để AI tự động trích xuất thông tin!
                </p>
            </field>
        </record>
    </data>
</odoo>
